<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="CanvasBrush">#0D121B</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBrush">#101722</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#151E2C</SolidColorBrush>
    <SolidColorBrush x:Key="RaisedBrush">#1C2839</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#2A384C</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#F0F4FC</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#B0BDD0</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#7DE4CE</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverBrush">#A5EFDF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoftBrush">#19382F</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#F0C989</SolidColorBrush>
    <SolidColorBrush x:Key="WarningSoftBrush">#392E20</SolidColorBrush>
    <SolidColorBrush x:Key="DangerBrush">#FFB2B9</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSoftBrush">#3D242F</SolidColorBrush>
    <Thickness x:Key="PageInset">32,28</Thickness>
    <Thickness x:Key="CardInset">24</Thickness>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="HeadingSize">28</x:Double>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource HeadingSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.5" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.metric"><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.8" /></Style>
  <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource CardInset}" /><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
  </Style>
  <Style Selector="Border.metricCard"><Setter Property="Padding" Value="18,16" /></Style>
  <Style Selector="Border.inset"><Setter Property="Background" Value="{DynamicResource SidebarBrush}" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16" /></Style>
  <Style Selector="Border.badge"><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,6" /></Style>
  <Style Selector="Border.badge TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="Border.badge.connected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
  <Style Selector="Border.badge.connected TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.badge.warning"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" /></Style>
  <Style Selector="Border.badge.warning TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.badge.outage"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></Style>
  <Style Selector="Border.badge.outage TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.sidebar"><Setter Property="Width" Value="232" /><Setter Property="Background" Value="{DynamicResource SidebarBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
  <Style Selector="Grid.page"><Setter Property="Margin" Value="{DynamicResource PageInset}" /><Setter Property="MaxWidth" Value="1120" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="Window.compact Border.sidebar"><Setter Property="Width" Value="188" /></Style>
  <Style Selector="Window.compact Grid.page"><Setter Property="Margin" Value="20,24" /></Style>
  <Style Selector="Window.compact TextBlock.navDescription"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Window.compact TextBlock.sidebarCaption"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Window.compact Border.metricCard"><Setter Property="Padding" Value="12,16" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="16,9" /><Setter Property="CornerRadius" Value="7" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="#102A25" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="Foreground" Value="#102A25" /></Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="#102A25" /></Style>
  <Style Selector="Button.secondary"><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="40" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Padding" Value="12,9" /></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="40" /><Setter Property="CornerRadius" Value="7" /></Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="14,12" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="ListBox.workspace ListBoxItem"><Setter Property="Padding" Value="12,14" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
  <Style Selector="ListBox.workspace ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="ListBox.workspace ListBoxItem:selected Path"><Setter Property="Stroke" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ListBox.workspace ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="CheckBox"><Setter Property="Margin" Value="0,2" /><Setter Property="MinHeight" Value="36" /></Style>
  <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="Expander /template/ ToggleButton /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="CornerRadius" Value="8" /></Style>
</Styles>
