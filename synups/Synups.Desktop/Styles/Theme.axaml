<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="CanvasBrush">#10151E</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#192230</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#F1F5FC</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#B3C0D2</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#91B9FF</SolidColorBrush>
    <Thickness x:Key="PageInset">28</Thickness>
    <Thickness x:Key="CardInset">24</Thickness>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="HeadingSize">28</x:Double>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource HeadingSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Padding" Value="{DynamicResource CardInset}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="40" />
  </Style>
</Styles>
